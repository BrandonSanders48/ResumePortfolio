# Gmail SMTP credentials for the contact form (same approach the old PHP site used)
CONTACT_MAIL_USERNAME=you@gmail.com
# Generate at https://myaccount.google.com/apppasswords — NOT your regular Gmail password
CONTACT_MAIL_APP_PASSWORD=your-16-character-app-password

# --- Resume editor (/editor) ---
# Same credential scheme as the old PHP editor: RESUME_EDITOR_USERNAME plus a
# bcrypt hash (the same $2y$/$2a$/$2b$ hash from the PHP site works as-is).
RESUME_EDITOR_USERNAME=your-username
RESUME_EDITOR_PASSWORD_HASH=$2y$10$replace-with-a-bcrypt-hash
# Random long string used to sign the editor's session cookie.
RESUME_EDITOR_SESSION_SECRET=replace-with-a-long-random-string
# Set to "1" to skip the login screen entirely (local dev only).
RESUME_EDITOR_BYPASS_LOGIN=0

# Used by the editor to fill {{CONTACT_PHONE_NUMBER}} / {{CONTACT_EMAIL}}
# tokens in Resume/Cover templates.
CONTACT_PHONE_NUMBER=
CONTACT_PUBLIC_EMAIL=

# Optional: a message shown via a JS alert() when the exported PDF is opened
# in Acrobat. Plain text, or base64-encoded in PDF_OPEN_ALERT_MESSAGE_B64.
PDF_OPEN_ALERT_MESSAGE=
PDF_OPEN_ALERT_MESSAGE_B64=

# In production, point this at a system Chromium binary instead of the one
# Puppeteer downloads (matches the existing PHP Dockerfile's approach).
PUPPETEER_EXECUTABLE_PATH=

# Microsoft Clarity analytics (same project ID env var name as the PHP site,
# so the existing value carries over as-is). Leave unset to disable tracking.
# Not injected on /editor.
CLARITY_PROJECT_ID=
